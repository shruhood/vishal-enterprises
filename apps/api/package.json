{
  "name": "@vishal/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply vishal_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply vishal_db --remote"
  },
  "dependencies": {
    "hono": "^4.5.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9",
    "wrangler": "^3.78.0"
  }
}
